rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // Security Helper Functions
    // --------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mamdouhfces1997@gmail.com' ||
        request.auth.token.email == 'omar.hassan.gebally@gmail.com' ||
        request.auth.token.email == 'admin@pymc-marketing.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // --------------------------------------------------------------------------
    // Users Profile Collection: /users/{userId}
    // --------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // API Keys Collection: /api_keys/{keyId}
    // --------------------------------------------------------------------------
    match /api_keys/{keyId} {
      allow read: if isResourceOwner() || isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isResourceOwner() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // Usage Telemetry Logs: /usage_logs/{logId}
    // --------------------------------------------------------------------------
    match /usage_logs/{logId} {
      allow read: if isResourceOwner() || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // Default Deny Rule for Any Unmatched Collections
    // --------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
