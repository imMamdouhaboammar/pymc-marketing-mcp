{
  "schema_version": "1",
  "name": "pymc-mmm-workflow",
  "version": "2.1.0",
  "domain": "mmm-lifecycle",
  "summary": "Run the principal constrained MMM lifecycle through registered datasets, fitting, state inspection, diagnosis, and specialist continuations.",
  "triggers": [
    "fit a media mix model",
    "run MMM analysis",
    "build an MMM from validated marketing data"
  ],
  "negative_triggers": [
    "why was my MMM rejected",
    "compare these fitted specifications",
    "optimize my media budget"
  ],
  "primary_tools": [
    "fit_mmm"
  ],
  "secondary_tools": [
    "get_model_status"
  ],
  "deprecated_tools": [],
  "administrative_tools": [],
  "required_resources": [
    "marketing://datasets/{dataset_id}",
    "marketing://models/{model_id}"
  ],
  "prerequisites": [
    "validated registered dataset with explicit date, target, channel, control, and dimension roles"
  ],
  "gates": [
    "dataset_validation_passed",
    "diagnostic_gate"
  ],
  "forbidden_before": [
    {
      "operations": [
        "fit_mmm"
      ],
      "until": "dataset_validation_passed"
    },
    {
      "operations": [
        "get_incremental_roas",
        "simulate_budget",
        "optimize_budget",
        "optimize_flighting"
      ],
      "until": "diagnostic_gate"
    }
  ],
  "fallback_skills": [
    "pymc-dataset-readiness",
    "pymc-job-resilience"
  ],
  "continuations": [
    "pymc-diagnostics-gate",
    "pymc-model-validation",
    "pymc-incrementality-evidence",
    "pymc-budget-optimization",
    "pymc-lift-calibration",
    "pymc-artifact-delivery"
  ],
  "maturity": "stable",
  "authoritative_sources": [
    "marketing://skills/references/scientific-answer-contract",
    "marketing://skills/references/scientific-source-ledger"
  ],
  "files": {
    "references": [
      "references/panel-mmm-guide.md",
      "references/transforms-guide.md"
    ],
    "examples": [
      "examples/e-commerce-mmm-walkthrough.md"
    ],
    "templates": [
      "templates/executive-brief.md",
      "templates/fit-mmm-input.json"
    ],
    "evals": [
      "evals/evals.json"
    ],
    "scripts": []
  }
}
