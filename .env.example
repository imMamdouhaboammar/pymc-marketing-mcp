# ==============================================================================
# PyMC Marketing MCP - Environment Configuration Example
# ==============================================================================

# Core File System Paths (Local or Container)
MARKETING_MCP_DATA_DIR=./data
MARKETING_MCP_INGEST_DIR=./inbox
MARKETING_MCP_ARTIFACT_DIR=./artifacts
MARKETING_MCP_METADATA_DB=./metadata.db
MARKETING_MCP_MAX_DATASET_MB=100
MARKETING_MCP_LOG_LEVEL=INFO

# Network & Server Binding
MARKETING_MCP_HOST=127.0.0.1
MARKETING_MCP_PORT=8000
MARKETING_MCP_TRANSPORT=stdio  # Options: stdio, streamable-http, sse

# Authentication & Security
MARKETING_MCP_AUTH_ENABLED=false
MARKETING_MCP_API_KEY=your-secure-api-key-here
# Set to 'true' to allow unauthenticated binding on 0.0.0.0 for public beta endpoints
MARKETING_MCP_ALLOW_ANONYMOUS_HTTP=false

# Google Cloud Run Deployment Placeholders
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_SERVICE_NAME=pymc-marketing-mcp
GCP_REPO_NAME=mcp-servers
GCS_BUCKET_NAME=your-gcp-project-id-pymc-mcp-artifacts
